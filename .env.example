# ─────────────────────────────────────────────────────
# Arcane Codex — environment variable reference
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────

# Port on the HOST machine that Docker Compose maps to the app's internal
# port 3000.  Change this if 3000 is already in use on your machine.
HOST_PORT=3000

# PostgreSQL connection used by Prisma.
# Docker Compose sets DATABASE_URL automatically for the app container.
# For local non-Docker runs, uncomment and customize this value.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arcane_codex?schema=public

# Docker Compose Postgres defaults (safe to keep for local development).
POSTGRES_DB=arcane_codex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional path to a legacy SQLite file for one-time migration into PostgreSQL.
# Used by: npm run db:migrate:sqlite-to-postgres
SQLITE_DATABASE_URL=file:./prisma/dev.db

# Google Sheets spreadsheet ID for character import/sync.
# This is the value between /d/ and /edit in the Google Sheets URL.
# The sheet must be publicly readable (Share → Anyone with the link → Viewer).
# Defaults to the official campaign character sheet if left unset.
GOOGLE_SHEET_ID=1OZ2WHyECHeO3yB-7nYhVbl7jq-VagGR0zh9Td75GJi0

# ── Google Service Account (required for DB → Sheet write-back only) ───────────
# Writing back to the Google Sheet requires a service account with Editor access.
#
# Option A — paste the full JSON credential file as a single-line JSON string:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"bot@...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
#
# Option B — provide the two key fields separately:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=bot@my-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n
#
# Setup steps:
#   1. In Google Cloud Console, create a Service Account and download the JSON key.
#   2. Share the Google Sheet with the service account email as an Editor.
#   3. Set either GOOGLE_SERVICE_ACCOUNT_JSON or both individual vars above.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google OAuth credentials for "Log in with Google".
# Create OAuth credentials in Google Cloud and register the following redirect URI:
#   <AUTH_URL>/api/auth/callback/google
# where AUTH_URL is the value you set below (e.g. http://hq.shank-home.net:3001).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js secret used to sign session tokens/cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL used by Auth.js to build callback/session URLs.
# *** IMPORTANT: set this to the exact origin that users browse to. ***
#   - Local dev:  http://localhost:3000
#   - Custom host: http://hq.shank-home.net:3001
# This MUST match the origin in your Google OAuth authorized redirect URI.
# It must be origin-only (scheme + host + port). Do NOT include a path.
# Leaving this as localhost when deploying on another host is the most common
# cause of "Unknown Action" errors from Auth.js.
AUTH_URL=http://localhost:3000

# Allow Auth.js to trust the host header forwarded by your runtime/proxy.
# Keep this as true when running behind Docker/reverse proxies you control.
AUTH_TRUST_HOST=true

# AI service URL consumed by Next.js server actions.
# Default points to the compose `ai` service. For the GPU profile, use
# http://ai-gpu:8000.
AI_SERVICE_URL=http://ai:8000

# Compose profiles control which mutually exclusive AI/Ollama service set starts.
# IMPORTANT: AI_MODE does not activate a Docker Compose profile. Set both values
# to `gpu` for GPU deployments. Keeping both at `cpu` is the default.
COMPOSE_PROFILES=cpu
AI_MODE=cpu

# AI backend/provider and model profile names.
AI_PROVIDER=local
AI_MODEL_CPU=codellama:7b-instruct-q4
AI_MODEL_GPU=mistral:7b-instruct

# Inference controls for text/stat generation suggestions.
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.4

# ── Ollama (self-hosted LLM) ───────────────────────────────────────────────────
# Ollama is the real LLM backend for chat and character generation.
# On first `docker compose up`, the ollama-init container will download the model
# (~5 GB for the default 8B model). Subsequent starts use the cached ollama_models volume.
#
# OLLAMA_BASE_URL — internal Docker network URL for the Ollama service.
#   CPU profile (default): http://ollama:11434
#   GPU profile:           http://ollama-gpu:11434
OLLAMA_BASE_URL=http://ollama:11434

# OLLAMA_MODEL — which model to run.
#   Recommended for 6 GB VRAM (fits entirely on GPU):  llama3.1:8b-instruct-q4_K_M
#   Higher quality, pure CPU (uses ~40 GB RAM):         llama3.1:70b-instruct-q4_K_M
#   Swap without any code changes by updating this var and re-running ollama-init.
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# OLLAMA_NUM_GPU_LAYERS — how many transformer layers to offload to the GPU.
#   -1  = auto (offload as many layers as fit in VRAM) — use for GPU profile
#    0  = CPU-only inference                           — use for CPU profile
#   N   = offload exactly N layers (partial offload, e.g. 20 for a 6 GB card)
# The CPU profile defaults to 0 so inference runs entirely in system RAM.
# The GPU profile defaults to -1 so all available VRAM is used.
OLLAMA_NUM_GPU_LAYERS=0

# OLLAMA_NUM_PARALLEL — how many concurrent inference requests Ollama handles.
#   1  = sequential (safe default, lowest memory)
#   2–4 = parallel requests; each extra slot uses additional VRAM or RAM.
#   Increase if multiple users are generating characters or chatting simultaneously.
OLLAMA_NUM_PARALLEL=1

# OLLAMA_NUM_THREAD — number of CPU threads per inference request.
#   0  = Ollama auto-detects based on available cores (recommended default)
#   N  = pin to exactly N threads — useful to cap CPU usage on shared machines.
OLLAMA_NUM_THREAD=0

# OLLAMA_KEEP_ALIVE — how long Ollama keeps the model loaded between requests.
#   "5m"  = Ollama default (unloads after 5 minutes of idle — causes cold-start delays)
#   "30m" = keep loaded for 30 minutes; balances memory use and responsiveness
#   "-1"  = keep loaded indefinitely (fastest responses, uses constant RAM/VRAM)
OLLAMA_KEEP_ALIVE=30m

# OLLAMA_MMAP — enable memory-mapped model loading (1 = on, 0 = off).
#   When on, the OS shares model pages across processes and can page them out under
#   memory pressure, reducing peak RAM usage at the cost of occasional disk reads.
OLLAMA_MMAP=1

# OLLAMA_REQUEST_TIMEOUT — seconds before the AI service gives up waiting for Ollama.
#   Increase for large models on slow hardware; decrease for faster failure detection.
OLLAMA_REQUEST_TIMEOUT=180

# Optional token for scheduled retraining endpoint:
# POST /api/admin/ai/retrain with header x-ai-retrain-token.
AI_RETRAIN_TOKEN=

# AI_WORKERS — number of Uvicorn worker processes for the FastAPI AI service.
#   Since inference is I/O-bound (waiting on Ollama), multiple workers allow the
#   service to accept new requests while one is pending. Each worker uses ~50 MB RAM.
#   2 is a sensible default; increase to 4 on machines with ample CPU and RAM.
AI_WORKERS=2

# AI_CONTEXT_CHAR_LIMIT — maximum characters of campaign lore/context injected per
#   AI request. Prevents runaway prompt sizes on large campaigns. The budget is split
#   evenly across active lore documents for chat, and across context sections for
#   character generation. Increase on machines with a large model context window.
AI_CONTEXT_CHAR_LIMIT=2000
